# Environment Variables — STUDARA Backend
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to Git

# ─── Server ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas ────────────────────────────────────
# 1. Go to https://cloud.mongodb.com
# 2. Create a free cluster
# 3. Click Connect → Drivers → copy the connection string
# 4. Replace <username> and <password> with your Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/studara?retryWrites=true&w=majority

# ─── JWT Secret ───────────────────────────────────────
# Use any long random string (min 32 characters)
# Generate one at: https://generate-secret.vercel.app/32
JWT_SECRET=replace_this_with_a_long_random_secret_string

# ─── Google Gemini / AI API ───────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_ai_api_key_here

# ─── YouTube Data API v3 ──────────────────────────────
# Get your key at: https://console.cloud.google.com
# Enable: YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# ─── Frontend URL (for CORS) ──────────────────────────
# Local development:
FRONTEND_URL=http://localhost:5173
# Production (update after deploying frontend to Vercel):
# FRONTEND_URL=https://studara.vercel.app
